# Healthcare QA Agents - Environment Configuration Example
# Purpose: Template for required environment variables across agents, LLMs, and API auth.

# Google Gemini API Key (Free tier via Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# LLM Model Name for Agent Reasoning (Free tier supported)
GEMINI_MODEL=gemini-2.5-flash

# JWT Secret Key for API Authentication (Change in production)
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key-32-chars

# JWT Algorithm and Token Expiry in Minutes
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# Optional Vertex AI Configuration (Set to true to use Google Cloud Vertex AI)
USE_VERTEX_AI=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
CONFIDENCE_THRESHOLD=0.75
